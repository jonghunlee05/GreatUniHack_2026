# Copy to .env.local and fill in.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Agent 2 (event generator). Keep mock on while developing: no API calls.
AGENT2_MOCK=true
AGENT2_MODEL=claude-opus-5-5
AGENT2_MAX_TOKENS=16000

# Scene 3 examiner (cheap model). Mock uses the multiple-choice fallback.
EXAMINER_MOCK=true
EXAMINER_MODEL=claude-haiku-5-5

# When the next chapter unlocks: "era" (finish time-travel, for now) or "assessment" (spec rule: pass the assessment)
UNLOCK_NEXT_ON=era
